% ============================================================
% referencias.bib
% Agrega aquí tus fuentes en formato BibTeX/BibLaTeX.
% biblatex-apa genera la referencia en APA 7 automáticamente.
%
% Tipos frecuentes:
%   @article  artículo de revista
%   @book     libro
%   @incollection  capítulo de libro
%   @phdthesis / @mastersthesis  tesis
%   @online   página web
%   @misc     software, dataset, informe
%
% Cita en el texto:
%   \parencite{clave}        -> (Autor, año)
%   \textcite{clave}         -> Autor (año)
%   \parencite[p. 12]{clave} -> (Autor, año, p. 12)
% ============================================================

@article{ejemplo2024,
  author  = {Apellido, Nombre and Otro, Nombre},
  title   = {Título del artículo de ejemplo},
  journal = {Nombre de la Revista},
  date    = {2024},
  volume  = {12},
  number  = {3},
  pages   = {45--67},
  doi     = {10.0000/ejemplo.2024}
}

@book{ejemplolibro2023,
  author    = {Apellido, Nombre},
  title     = {Título del libro de ejemplo},
  date      = {2023},
  publisher = {Editorial},
  address   = {Ciudad}
}

@phdthesis{ejemplotesis2022,
  author  = {Apellido, Nombre},
  title   = {Título de la tesis de ejemplo},
  date    = {2022},
  type    = {Tesis doctoral},
  school  = {Nombre de la Universidad},
  address = {Ciudad}
}

@online{ejemploweb2025,
  author  = {{Nombre de la institución}},
  title   = {Título de la página web de ejemplo},
  date    = {2025},
  url     = {https://ejemplo.org},
  urldate = {2025-01-01}
}

@misc{ejemplosoftware2024,
  author  = {{Nombre del proyecto}},
  title   = {Nombre del software o dataset},
  date    = {2024},
  version = {1.0},
  url     = {https://ejemplo.org/software},
  note    = {Software}
}
